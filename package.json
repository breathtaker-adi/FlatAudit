{
  "name": "listing-trust-analyzer",
  "version": "1.0.0",
  "description": "Privacy-preserving rental listing scam signal detector and explainability badge (Manifest V3 + FastAPI)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "demo": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=req.url==='/'?'index.html':req.url.replace(/^\\//,'');let fp=path.join(__dirname,'web-demo',f);if(fs.existsSync(fp)){res.setHeader('Content-Type',f.endsWith('.css')?'text/css':f.endsWith('.js')?'application/javascript':'text/html');fs.createReadStream(fp).pipe(res);}else{res.writeHead(404);res.end('Not found');}}).listen(8080,()=>console.log('Demo server running at http://localhost:8080'));\""
  },
  "keywords": [
    "cybersecurity",
    "browser-extension",
    "scam-detection",
    "dhash",
    "rental-fraud",
    "privacy-preserving"
  ],
  "author": "Listing Trust Analyzer Team",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
